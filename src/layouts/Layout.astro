---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site,
).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + "migrate-vue"
  : "migrate-vue - Vue 3 and Nuxt 4 migration support";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager via Anogate -->
    <script type="text/plain" data-anogate="GTM" is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-N3R7DHWT");
    </script>
    <script
      src="https://load01.anogate.io/js/?id=AG-31F914ALD1"
      async
      id="Anogate"
      is:inline>
    </script>
    <!-- End Google Tag Manager via Anogate -->

    <SEO
      title={makeTitle}
      description="Modernize Vue 2 and Nuxt 2 applications with a clear path to Vue 3 and Nuxt 4."
      canonical={canonicalURL}
      twitter={{
        creator: "@saulmurf",
        // site: "@web3templates",
        card: "summary_large_image",
        image: resolvedImageWithDomain,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `migrate-vue - Vue 3 and Nuxt 4 migration support`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Migrate Vue 2 to Vue 3 with safe, maintainable modernization",
        },
        optional: {
          locale: "en",
        },
      }}
    />
  </head>
  <body class="overflow-x-hidden bg-white text-[#34495E] antialiased">
    <a
      href="#main-content"
      class="fixed left-4 top-3 z-[100] -translate-y-20 rounded-md bg-[#34495E] px-4 py-2 text-sm font-semibold text-white transition-transform focus:translate-y-0">
      Skip to content
    </a>
    <Navbar />
    <main id="main-content"><slot /></main>
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
      ::selection {
        background: #b9ead3;
        color: #213547;
      }
    </style>
  </body>
</html>
