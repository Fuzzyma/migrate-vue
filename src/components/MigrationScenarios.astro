---
import { Icon } from "astro-icon/components";

const migrationScenarios = [
  {
    from: { name: "Vue 2", icon: "skill-icons:vuejs-light" },
    to: { name: "Vue 3", icon: "skill-icons:vuejs-light" },
  },
  {
    from: { name: "Nuxt 2", icon: "skill-icons:nuxtjs-light" },
    to: { name: "Nuxt 4", icon: "skill-icons:nuxtjs-light" },
  },
  {
    from: { name: "Vuex", icon: "skill-icons:vuejs-light" },
    to: { name: "Pinia", icon: "skill-icons:pinia-light" },
  },
  {
    from: { name: "webpack", icon: "skill-icons:webpack-light" },
    to: { name: "Vite", icon: "skill-icons:vite-light" },
  },
  {
    from: { name: "vue-cli", icon: "skill-icons:vuejs-light" },
    to: { name: "Vite", icon: "skill-icons:vite-light" },
  },
  {
    from: { name: "Jest", icon: "skill-icons:jest" },
    to: { name: "Vitest", icon: "skill-icons:vitest-light" },
  },
  {
    from: { name: "Vuetify", icon: "skill-icons:vuetify-light" },
    to: { name: "Vuetify 3", icon: "skill-icons:vuetify-light" },
  },
  {
    from: { name: "Quasar", icon: "devicon:quasar" },
    to: { name: "Quasar 2", icon: "devicon:quasar" },
  },
];
---

<section class="py-16 md:py-20" aria-labelledby="scenarios-title">
  <h2
    id="scenarios-title"
    class="text-center text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
    Migration Scenarios
  </h2>
  <p class="mx-auto mt-3 max-w-2xl text-center leading-relaxed text-gray-600">
    The framework and the ecosystem around it move along the same planned path.
  </p>

  <div class="mt-10 border-y border-slate-200 px-5 py-4 sm:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4">
      {
        migrationScenarios.map((scenario, index) => (
          <div
            class:list={[
              "flex min-w-0 items-center gap-3 border-b border-slate-200 py-5 sm:px-4",
              index % 2 === 0 && "sm:border-r",
              index >= migrationScenarios.length - 2 && "sm:border-b-0",
              index % 4 !== 3 && "lg:border-r",
              index >= migrationScenarios.length - 4 && "lg:border-b-0",
            ]}>
            <Icon name={scenario.from.icon} class="h-7 w-7 shrink-0" />
            <span class="min-w-0 flex-1 text-sm font-medium text-slate-600">
              {scenario.from.name}
            </span>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-[#b9ead3] bg-white text-[#33a06f]">
              <Icon name="mi:arrow-right" />
            </span>
            <Icon name={scenario.to.icon} class="h-7 w-7 shrink-0" />
            <span class="min-w-0 flex-1 text-sm font-semibold text-gray-900">
              {scenario.to.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
