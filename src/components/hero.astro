---
import { Image } from "astro:assets";
import heroImage from "assets/hero-consultant-flipchart.webp";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<section
  class="grid min-w-0 place-items-center gap-8 overflow-hidden pb-16 pt-14 md:grid-cols-2 md:pb-24 md:pt-16">
  <div class="hidden w-4/5 py-6 md:order-1 md:block">
    <Image
      src={heroImage}
      alt="The migrate-vue consultant thinking beside a flipchart that maps Vue 2 to Vue 3 and related ecosystem upgrades"
      widths={[400, 600, 800]}
      sizes="(max-width: 1024px) 42vw, 520px"
      loading="eager"
      format="webp"
      class="h-auto w-full"
    />
  </div>

  <div class="min-w-0">
    <h1
      class="flex flex-wrap items-center gap-x-2 gap-y-1 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl xl:text-7xl xl:tracking-tighter">
      <span class="text-[#42b883]">Migrate</span>
      <span
        class="bg-gradient-to-r from-[#42b883] to-[#34495E] bg-clip-text text-transparent">
        Vue
      </span>
      <span class="inline-flex items-center whitespace-nowrap text-[#34495E]">
        2<Icon name="mi:arrow-right" class="mx-1" />3
      </span>
    </h1>

    <p
      class="mt-4 flex items-center gap-2 text-sm font-semibold text-slate-500 sm:text-base">
      <Icon name="skill-icons:nuxtjs-light" class="h-5 w-5" />
      Nuxt upgrades from 2 through 4
    </p>

    <p
      class="mt-5 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
      Modernize an aging Vue or Nuxt codebase without losing control of the
      product. I assess the risks, plan the route, and deliver the upgrade in
      testable steps.
    </p>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <Link
        href="/guide/"
        class="flex items-center justify-center gap-1"
        style="outline">
        <Icon class="h-5 w-5" name="mdi:learn-outline" />
        Learn how to migrate
      </Link>
      <Link
        size="lg"
        href="/pricing"
        class="flex items-center justify-center gap-1">
        <Icon class="h-5 w-5" name="mdi:coins" />
        Check my offer
      </Link>
    </div>
  </div>
</section>
