---
import { Icon } from "astro-icon/components";
import Link from "./ui/link.astro";
---

<section
  class="my-16 flex flex-col items-center gap-6 rounded-2xl border border-[#b9ead3] bg-white px-6 py-14 text-center md:my-20 md:py-16">
  <h2 class="text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
    Ready to migrate?
  </h2>
  <p class="max-w-2xl text-lg leading-relaxed text-gray-700">
    Plan a maintainable path to Vue 3 or Nuxt 4 without turning the upgrade into
    a rewrite.
  </p>
  <Link
    size="lg"
    href="/pricing"
    class="flex gap-1 items-center justify-center">
    <Icon class="text-white w-5 h-5" name="mdi:coins" />
    Check my offer
  </Link>
</section>
