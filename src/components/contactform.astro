---
import Button from "./ui/button.astro";
---

<form
  method="POST"
  id="form"
  data-netlify="true"
  netlify-honeypot="botcheck"
  name="contact"
  action="/form-submitted">
  <p class="hidden">
    <label>Do not fill this out: <input name="botcheck" /></label>
  </p>
  <div class="mb-5">
    <label for="name" class="mb-2 block text-sm font-medium text-gray-700">
      Full name <span aria-hidden="true">*</span>
    </label>
    <input
      id="name"
      type="text"
      autocomplete="name"
      placeholder="Your name"
      required
      class="w-full rounded-md border-2 border-gray-300 px-4 py-3 outline-none transition placeholder:text-gray-500 focus:border-[#42b883] focus:ring-4 focus:ring-green-50"
      name="name"
    />
  </div>
  <div class="mb-5">
    <label
      for="email_address"
      class="mb-2 block text-sm font-medium text-gray-700">
      Email address <span aria-hidden="true">*</span>
    </label>
    <input
      id="email_address"
      type="email"
      autocomplete="email"
      placeholder="you@company.com"
      name="email"
      required
      class="w-full rounded-md border-2 border-gray-300 px-4 py-3 outline-none transition placeholder:text-gray-500 focus:border-[#42b883] focus:ring-4 focus:ring-green-50"
    />
  </div>
  <div class="mb-5">
    <label for="subject" class="mb-2 block text-sm font-medium text-gray-700">
      Subject
    </label>
    <select
      id="subject"
      name="subject"
      class="w-full rounded-md border-2 border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-[#42b883] focus:ring-4 focus:ring-green-50">
      <option value="general">General enquiry</option>
      <option value="consultation">Free consultation</option>
      <option value="report">Migration report</option>
      <option value="quote">Full migration quote</option>
      <option value="hire">Freelance support</option>
    </select>
  </div>
  <div class="mb-4">
    <label for="message" class="mb-2 block text-sm font-medium text-gray-700">
      Your message <span aria-hidden="true">*</span>
    </label>
    <!-- prettier-ignore -->
    <textarea
      id="message"
      name="message"
      required
      placeholder="Current stack, codebase size, deadline, and your biggest concern"
      class="h-36 w-full rounded-md border-2 border-gray-300 px-4 py-3 outline-none transition placeholder:text-gray-500 focus:border-[#42b883] focus:ring-4 focus:ring-green-50"></textarea>
  </div>
  <Button type="submit" size="lg" block>Send message</Button>
  <p class="mt-3 text-xs leading-relaxed text-gray-500">
    I use your details only to reply to this enquiry. See the <a
      href="/privacy"
      class="underline">
      privacy policy
    </a>.
  </p>
</form>

<script is:inline>
  const subject = document.getElementById("subject");
  const requestedSubject = document.location.hash.slice(1);
  if (
    subject &&
    ["consultation", "report", "quote", "hire"].includes(requestedSubject)
  ) {
    subject.value = requestedSubject;
  }
</script>
