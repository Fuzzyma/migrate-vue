---
import { Icon } from "astro-icon/components";

const benefits = [
  {
    title: "Supported and maintainable",
    description:
      "Move away from end-of-life dependencies and onto a stack that can keep receiving fixes and ecosystem support.",
    icon: "mdi:shield-check-outline",
  },
  {
    title: "Modern Vue patterns",
    description:
      "Use Vue 3 features where they improve clarity, reuse, and the long-term shape of the codebase.",
    icon: "mdi:source-branch",
  },
  {
    title: "Faster feedback loops",
    description:
      "Adopt modern build and test tooling such as Vite and Vitest without turning the migration into a rewrite.",
    icon: "mdi:lightning-bolt-outline",
  },
  {
    title: "Ready for what comes next",
    description:
      "Create a stable destination for Vue 3 and Nuxt 4 instead of carrying temporary compatibility layers forever.",
    icon: "mdi:arrow-decision-outline",
  },
];
---

<section class="py-16 md:py-20" aria-labelledby="benefits-title">
  <h2
    id="benefits-title"
    class="text-center text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
    Why Modernize Your Vue App?
  </h2>
  <p class="mx-auto mt-3 max-w-2xl text-center leading-relaxed text-gray-600">
    The goal is not only a new version number, but a healthier product for the
    team maintaining it.
  </p>

  <div class="mt-10 grid border-y border-slate-200 sm:grid-cols-2">
    {
      benefits.map((benefit, index) => (
        <div
          class:list={[
            "flex gap-4 py-7 sm:px-7",
            index > 0 && "border-t border-slate-200 sm:border-t-0",
            index > 1 && "sm:border-t sm:border-slate-200",
            index % 2 === 0 && "sm:border-r sm:border-slate-200",
          ]}>
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-[#b9ead3] bg-[#f2fbf7] text-xl text-[#287f5d]">
            <Icon name={benefit.icon} />
          </span>
          <div>
            <h3 class="text-lg font-semibold text-gray-900">{benefit.title}</h3>
            <p class="mt-2 leading-relaxed text-gray-600">
              {benefit.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
