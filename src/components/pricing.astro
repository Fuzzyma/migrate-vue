---
import { Tick } from "@components/ui/icons";
import Link from "@components/ui/link.astro";

const { plan } = Astro.props;
---

<article
  class:list={[
    "relative flex h-full w-full flex-col rounded-lg border border-slate-200 bg-white px-6 py-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md",
    plan.popular && "border-[#41B883] ring-1 ring-[#41B883]",
  ]}>
  {
    plan.popular && (
      <span class="absolute right-4 top-0 -translate-y-1/2 rounded-full bg-[#287f5d] px-3 py-1 text-xs font-semibold text-white">
        Recommended
      </span>
    )
  }
  <div class="text-center">
    <h2 class="text-lg font-semibold text-gray-700">{plan.name}</h2>
    <p class="mt-3 text-4xl font-bold text-black md:text-4xl">
      {plan.price}
    </p>
    {
      plan.vat && (
        <p class="mt-1 text-sm font-medium text-gray-500">VAT excluded</p>
      )
    }
    <!-- {
        plan.price.original && (
          <p class="mt-1 text-xl font-medium text-gray-400 line-through md:text-2xl">
            {plan.price.original}
          </p>
        )
      } -->
  </div>
  <ul
    class={`grid ${plan.vat ? "mt-2" : "mt-8"} text-left gap-y-4 justify-center md:justify-start`}>
    {
      plan.features.map((item) => (
        <li class="flex items-start gap-3 text-gray-800 w-64 md:w-full">
          <Tick class="w-6 h-6" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 flex grow text-center leading-relaxed text-gray-600">
    {plan.description}
  </div>

  <div class="flex mt-8">
    <Link
      href={plan.button.link || "#"}
      block
      style={plan.popular ? "primary" : "outline"}
      disabled={plan.button.disabled || false}>
      {plan.button.text || "Get Started"}
    </Link>
  </div>
</article>
