---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "border-2 border-black hover:bg-black text-black hover:text-white",
  primary:
    "bg-[#33a06f] text-white hover:bg-[#155f3e] border-2 border-transparent shadow-sm",
};
---

<button
  {...rest}
  class:list={[
    "rounded-md text-center font-medium transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#42b883] focus-visible:ring-offset-2",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}>
  <slot />
</button>
