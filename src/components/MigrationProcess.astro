---
const migrationSteps = [
  {
    title: "Assessment",
    description:
      'I review the codebase, dependencies, tests, and deployment constraints. You get a practical sequence, risks, and estimate before committing to the work. <a href="/pricing">Learn about the assessment</a> or <a href="/guide">start with the guide</a>.',
  },
  {
    title: "Preparation",
    description:
      "We stabilize build tooling, testing, dependencies, and the migration branch so every later change can be checked safely.",
  },
  {
    title: "Migration",
    description:
      "Components, routing, state, modules, and framework conventions move in controlled slices while behavior stays reviewable.",
  },
  {
    title: "Testing",
    description:
      "Automated checks and targeted manual testing verify real user journeys, not only whether the new application builds.",
  },
  {
    title: "Deployment",
    description:
      "The release is planned, monitored, and documented so your team can confidently own the modernized codebase.",
  },
];
---

<section class="py-16 md:py-20" aria-labelledby="process-title">
  <div class="rounded-2xl bg-[#f2fbf7] px-6 py-10 md:px-10 md:py-12">
    <h2
      id="process-title"
      class="text-center text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
      How the Migration Process Works
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center leading-relaxed text-gray-600">
      One visible path from the first technical review to a production-ready
      handover.
    </p>

    <ol class="relative mx-auto mt-12 max-w-4xl">
      <div
        aria-hidden="true"
        class="absolute bottom-8 left-5 top-8 w-px bg-[#b9ead3] sm:left-7">
      </div>
      {
        migrationSteps.map((step, index) => (
          <li class="relative grid grid-cols-[2.5rem_1fr] gap-5 border-b border-[#cfe8dc] py-7 last:border-b-0 sm:grid-cols-[3.5rem_10rem_1fr] sm:gap-7">
            <span class="z-10 grid h-10 w-10 place-items-center rounded-full border border-[#8fd5b3] bg-white font-mono text-sm font-bold text-[#287f5d] sm:h-14 sm:w-14">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="pt-2 text-xl font-semibold text-gray-900 sm:pt-3">
              {step.title}
            </h3>
            <p
              class="col-start-2 leading-relaxed text-gray-600 sm:col-start-3 sm:pt-3 md:text-lg [&_a]:font-medium [&_a]:text-[#287f5d] [&_a]:underline [&_a]:underline-offset-2"
              set:html={step.description}
            />
          </li>
        ))
      }
    </ol>
  </div>
</section>
